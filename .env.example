# Copy to .env (gitignored) and fill in. Only keys and tokens without OIDC support live here;
# cloud CLIs (gcloud, az, aws, gh) keep their own credentials. See infra/BOOTSTRAP.md.

# GCP project IDs (the repo is public, so real IDs live here, not in committed files)
GCP_PROJECT_ID=
GCP_GEMINI_PROJECT_ID=
# Terraform state bucket, created by infra/terraform/bootstrap (M1)
TF_STATE_BUCKET=

# Local dev only (free tier, AI Studio key from the chatbot-gemini project). Tests and CI use the mock LLM.
# Deployed environments read it from each cloud's secret store, never from .env.
GEMINI_API_KEY=
# gemini (default) or mock. The mock needs no key and never calls the network.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Traces: none (default), console (print spans locally) or gcp (Cloud Trace; set on Cloud Run)
TRACE_EXPORTER=none
# Tokens: none (default; every token is refused, no token = anonymous) or firebase (set on Cloud Run)
IDENTITY_PROVIDER=none
# Usage rows: none (default) or neon, which needs NEON_USAGE_URL (the usage_writer connection string)
USAGE_SINK=none
# Bot check: none (default) or turnstile, which needs TURNSTILE_SECRET and ALLOWED_ORIGINS
BOT_CHECK=none
ALLOWED_ORIGINS=
# Sign-in links: none (default; /v1/sign-in-link answers 503) or identity_platform, which needs
# GOOGLE_CLOUD_PROJECT and SIGN_IN_CONTINUE_URL (the chat page); set on Cloud Run
SIGN_IN_SENDER=none
# Embeddings: none (default), hash (tests, no model) or e5, which needs E5_MODEL_DIR (baked into
# the image; locally: uv run python -m adapters.shared.e5 fetch .models/e5)
EMBEDDER=none
# Retrieval: none (default), memory (indexes knowledge/ at startup; needs EMBEDDER) or neon (needs
# NEON_KNOWLEDGE_URL, the app_gcp connection string). RETRIEVAL_MIN_SCORE drops weaker chunks;
# 0.82 is calibrated for e5 (#86), and the hash embedder's scores are far lower, so leave it at 0.
KNOWLEDGE_STORE=none
RETRIEVAL_MIN_SCORE=0
CLOUD=local

NEON_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AWS_PROFILE=showcase
