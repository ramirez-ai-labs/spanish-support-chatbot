# Copy to .env (gitignored) and fill in. Only keys and tokens without OIDC support live here;
# cloud CLIs (gcloud, az, aws, gh) keep their own credentials. See infra/BOOTSTRAP.md.

# GCP project IDs (the repo is public, so real IDs live here, not in committed files)
GCP_PROJECT_ID=
GCP_GEMINI_PROJECT_ID=
# Terraform state bucket, created by infra/terraform/bootstrap (M1)
TF_STATE_BUCKET=

# Local dev only (free tier, AI Studio key from the chatbot-gemini project). Tests and CI use the mock LLM.
# Deployed environments read it from each cloud's secret store, never from .env.
GEMINI_API_KEY=
# gemini (default) or mock. The mock needs no key and never calls the network.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Traces: none (default), console (print spans locally) or gcp (Cloud Trace; set on Cloud Run)
TRACE_EXPORTER=none
# Tokens: none (default; every token is refused, no token = anonymous) or firebase (set on Cloud Run)
IDENTITY_PROVIDER=none
# Usage rows: none (default) or neon, which needs NEON_USAGE_URL (the usage_writer connection string)
USAGE_SINK=none
CLOUD=local

NEON_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AWS_PROFILE=showcase
