# Copy to .env (gitignored) and fill in. Only keys and tokens without OIDC support live here;
# cloud CLIs (gcloud, az, aws, gh) keep their own credentials. See infra/BOOTSTRAP.md.

# GCP project IDs (the repo is public, so real IDs live here, not in committed files)
GCP_PROJECT_ID=
GCP_GEMINI_PROJECT_ID=

# Local dev only (free tier, AI Studio key from the chatbot-gemini project). Tests and CI use the mock LLM.
# Deployed environments read it from each cloud's secret store, never from .env.
GEMINI_API_KEY=

NEON_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
AWS_PROFILE=showcase
