# Security headers Cloudflare Pages sends with every page. The deploy job replaces __API_ORIGIN__
# with the API's URL: the page may only call that API, run its own script and Turnstile's, and
# show Turnstile's frame.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src __API_ORIGIN__; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
